# Copy this file to ".env" and fill in the values. Never share or commit .env.

# Buffer: publish.buffer.com/settings/api  -> create a personal API key
BUFFER_API_KEY=

# Run  python mirror_to_instagram.py --setup  to find these three
BUFFER_ORG_ID=
FACEBOOK_CHANNEL_ID=
INSTAGRAM_CHANNEL_ID=

# Google Sheet log
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=service-account.json
GOOGLE_SHEET_TAB=Log

# "now" = publish ~2 minutes after you run it; "queue" = next slot in your Instagram Buffer queue
POST_MODE=now
POST_DELAY_MINUTES=2

# Optional line added to every Instagram caption (links aren't clickable on Instagram).
# Use \n for a line break. Leave blank for none.
INSTAGRAM_CAPTION_SUFFIX=Full story at the link in our bio.

# Optional fixed alt text. If blank, the first line of the caption is used.
IMAGE_ALT_TEXT=
